---
// Large case-study tile: story on the left, headline numbers on a dark panel on the right.
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'caseStudies'> }
const { entry } = Astro.props;
const d = entry.data;
const stats = d.metrics.slice(0, 3);
---
<a class="case tilt" data-tilt="2.5" href={`/case-studies/${entry.id}/`}>
  <div class="body">
    <p class="eyebrow">{d.org}</p>
    <h3>{d.title}</h3>
    <p class="muted summary">{d.summary}</p>
    <ul class="chips">{d.tools.slice(0, 4).map((t) => <li>{t}</li>)}</ul>
    <span class="link-arrow more">Read the case study <span class="arrow" aria-hidden="true">→</span></span>
  </div>
  {stats.length > 0 && (
    <div class="stats on-dark">
      <div class="aurora" aria-hidden="true"></div>
      <dl>
        {stats.map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd class="grad-text" data-count>{m.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  )}
</a>

<style>
  .case { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); border-radius: var(--radius-lg); overflow: hidden; background: var(--surface); border: 1px solid var(--border); color: inherit; text-decoration: none; box-shadow: var(--shadow); }
  .case:hover { box-shadow: var(--shadow-lg); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
  .body { padding: clamp(1.6rem, 4vw, 3rem); display: flex; flex-direction: column; align-items: flex-start; gap: 0.9rem; }
  .body .eyebrow { margin: 0; }
  h3 { font-size: clamp(1.6rem, 3.2vw, 2.4rem); letter-spacing: -0.035em; line-height: 1.08; margin: 0; }
  .summary { margin: 0; font-size: 1rem; }
  .more { margin-top: auto; padding-top: 0.75rem; color: var(--accent); }
  .more .arrow { display: inline-block; transition: transform 0.3s var(--ease); }
  .case:hover .more .arrow { transform: translateX(4px); }
  .stats { position: relative; overflow: hidden; isolation: isolate; background: radial-gradient(120% 100% at 80% 0%, #1a2530 0%, #10161b 60%, #0a0f13 100%); color: var(--text); display: flex; align-items: center; padding: clamp(1.6rem, 4vw, 3rem); }
  dl { position: relative; z-index: 1; margin: 0; display: grid; gap: 1.6rem; width: 100%; }
  dl div { display: flex; flex-direction: column-reverse; gap: 0.15rem; }
  dt { color: var(--muted); font-size: 0.92rem; }
  dd { margin: 0; font-size: clamp(2.2rem, 4.6vw, 3.5rem); font-weight: 700; letter-spacing: -0.045em; line-height: 1; white-space: nowrap; width: fit-content; }
  @media (max-width: 820px) {
    .case { grid-template-columns: 1fr; }
    dl { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1.25rem; }
    dd { font-size: 2.1rem; }
  }
</style>
