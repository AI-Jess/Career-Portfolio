---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** True when the page opens with a dark .stage section: the nav starts in its "over dark" style. */
  stage?: boolean;
}
const { title, description = site.tagline, stage = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const path = Astro.url.pathname;
const nav = [
  { href: '/case-studies/', label: 'Case studies' },
  { href: '/stack/', label: 'Stack' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---
<!doctype html>
<html lang="en" data-nav={stage ? 'on-dark' : 'default'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#10161b" />
    <script is:inline>
      // Runs before first paint: apply the saved theme (light is the default) and flag that JS is on.
      (function () {
        var d = document.documentElement, t = 'light';
        try { if (localStorage.getItem('theme') === 'dark') t = 'dark'; } catch (e) {}
        d.setAttribute('data-theme', t);
        d.classList.add('js');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
        // Safety net: if the main script hasn't started after a few seconds, reveal all content
        setTimeout(function () { if (!window.__siteReady) d.classList.add('no-reveal'); }, 4000);
      })();
    </script>
  </head>
  <body class:list={{ 'has-stage': stage }}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/"><img src="/brand/mark-64.png" alt="" width="30" height="30" />{site.name}</a>
        <nav id="site-nav" aria-label="Primary">
          {nav.map((n, i) => (
            <a href={n.href} style={`--i:${i}`} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <div class="tools">
          <button class="icon-btn theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch to dark mode">
            <svg class="moon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <svg class="sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></g></svg>
          </button>
          <button class="icon-btn menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav">
            <span></span><span></span>
          </button>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap foot">
        <a class="brand" href="/"><img src="/brand/mark-64.png" alt="" width="30" height="30" />{site.name}</a>
        <nav aria-label="Footer">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          <a href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
        </nav>
        <p class="muted">© {new Date().getFullYear()} {site.name}. {site.role}.</p>
      </div>
    </footer>
  </body>
</html>

<script>
  import '../scripts/site';
</script>

<style>
  .skip { position: fixed; left: 12px; top: -60px; z-index: 100; background: var(--accent); color: var(--accent-ink); padding: 0.5rem 0.9rem; border-radius: 8px; font-weight: 600; text-decoration: none; }
  .skip:focus { top: 10px; }

  /* Glass navigation bar */
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 50; color: var(--text);
    background: color-mix(in srgb, var(--bg) 76%, transparent);
    -webkit-backdrop-filter: saturate(180%) blur(20px); backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
    transition: background 0.4s, border-color 0.4s, color 0.4s;
    view-transition-name: site-header;
  }
  :global(html[data-nav='on-dark']) .site-header { background: color-mix(in srgb, #10161b 50%, transparent); border-bottom-color: transparent; }
  :global(html:not(.js)) .site-header { position: sticky; background: var(--bg); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: var(--nav-h); }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; font-weight: 650; color: var(--text); text-decoration: none; letter-spacing: -0.015em; white-space: nowrap; }
  .brand img { width: 30px; height: 30px; border-radius: 8px; flex: none; }
  #site-nav { display: flex; gap: 1.6rem; align-items: center; margin-left: auto; }
  #site-nav a { color: var(--muted); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.2s; }
  #site-nav a:hover, #site-nav a[aria-current='page'] { color: var(--text); }
  .tools { display: flex; align-items: center; gap: 0.4rem; }
  .icon-btn { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 999px; border: 1px solid transparent; background: transparent; color: var(--text); cursor: pointer; padding: 0; transition: background 0.2s, border-color 0.2s; }
  .icon-btn:hover { background: color-mix(in srgb, var(--text) 9%, transparent); }
  .theme-toggle .sun { display: none; }
  :global([data-theme='dark']) .theme-toggle .sun { display: block; }
  :global([data-theme='dark']) .theme-toggle .moon { display: none; }
  .menu-toggle { display: none; position: relative; }
  .menu-toggle span { position: absolute; left: 9px; right: 9px; height: 1.5px; background: currentColor; border-radius: 2px; transition: transform 0.35s var(--ease), top 0.35s var(--ease); }
  .menu-toggle span:first-child { top: 13px; }
  .menu-toggle span:last-child { top: 20px; }
  :global(html[data-menu='open']) .menu-toggle span:first-child { top: 16.5px; transform: rotate(45deg); }
  :global(html[data-menu='open']) .menu-toggle span:last-child { top: 16.5px; transform: rotate(-45deg); }

  main { min-height: 70vh; padding-top: var(--nav-h); }
  .has-stage main, :global(html:not(.js)) main { padding-top: 0; }

  .site-footer { border-top: 1px solid var(--border); margin-top: clamp(4rem, 9vw, 7rem); padding: 2.5rem 0 3rem; font-size: 0.9rem; }
  .foot { display: grid; gap: 1.25rem; grid-template-columns: 1fr auto; align-items: center; }
  .foot nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; }
  .foot nav a { color: var(--muted); text-decoration: none; }
  .foot nav a:hover { color: var(--text); }
  .foot p { grid-column: 1 / -1; margin: 0; font-size: 0.82rem; }

  @media (max-width: 760px) {
    .foot { grid-template-columns: 1fr; }
    /* With JS: links collapse into a full-width sheet opened by the menu button */
    :global(html.js) .menu-toggle { display: inline-grid; }
    :global(html.js) #site-nav {
      position: fixed; inset: var(--nav-h) 0 auto 0; margin: 0; padding: 1.25rem 20px 2rem;
      flex-direction: column; align-items: stretch; gap: 0;
      background: color-mix(in srgb, var(--bg) 92%, transparent);
      -webkit-backdrop-filter: saturate(180%) blur(24px); backdrop-filter: saturate(180%) blur(24px);
      border-bottom: 1px solid var(--border);
      visibility: hidden; opacity: 0; transform: translateY(-10px);
      transition: opacity 0.3s var(--ease), transform 0.3s var(--ease), visibility 0s 0.3s;
    }
    :global(html.js[data-menu='open']) #site-nav { visibility: visible; opacity: 1; transform: none; transition-delay: 0s; }
    :global(html.js) #site-nav a { font-size: 1.6rem; font-weight: 650; letter-spacing: -0.03em; color: var(--text); padding: 0.7rem 0; border-bottom: 1px solid var(--border); }
    :global(html.js[data-menu='open']) .site-header { background: color-mix(in srgb, var(--bg) 92%, transparent); }
    /* Without JS: links wrap onto a second row */
    :global(html:not(.js)) .bar { flex-wrap: wrap; padding-top: 0.6rem; padding-bottom: 0.6rem; }
    :global(html:not(.js)) #site-nav { width: 100%; order: 3; gap: 1rem; margin: 0; }
  }
</style>
