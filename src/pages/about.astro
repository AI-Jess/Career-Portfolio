---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
---
<Base title="About" description={`About ${site.name}: Business Analyst turned Power Platform and AI developer for legal operations.`} stage>
  <section class="stage stage-round page-stage" data-stage>
    <div class="aurora" aria-hidden="true"></div>
    <div class="wrap intro">
      <div>
        <p class="eyebrow">About</p>
        <h1>{site.intro[0].replace(/\.$/, '')}<span class="grad-text">.</span></h1>
        <p class="lead">
          I'm a Business Analyst at a large IP law firm, moving into hands-on development with
          Power Automate, Power Apps, Power BI, and Copilot agents.
        </p>
        <div class="btn-row">
          <a class="btn primary" href={site.linkedin} target="_blank" rel="noopener">Connect on LinkedIn <span class="arrow" aria-hidden="true">→</span></a>
          {site.resumePdf && <a class="btn ghost" href={site.resumePdf}>Résumé (PDF)</a>}
        </div>
      </div>
      <div class="portrait tilt" data-tilt="7">
        <img src="/brand/avatar.webp" alt={`Illustrated avatar of ${site.name}`} width="640" height="640" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap cols">
      <div data-reveal>
        <p class="eyebrow">Focus</p>
        <h2>Legal operations.</h2>
      </div>
      <div class="body" data-reveal style="--i:1">
        <p class="lead">The intake, data, and hand-offs that keep matters moving.</p>
        <p>
          Coming from the BA side means I start with the process, not the tool. I gather requirements
          with the people doing the work, design the solution, build and test it, and support it in
          production.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Recent work</p>
        <h2>What I've been building.</h2>
      </div>
      <div class="work">
        <a class="item tilt" data-tilt="3" data-reveal href="/case-studies/ip-staffing-updates/">
          <h3>Staffing updates for IP Operations</h3>
          <p class="muted">Designed and built a Forms-to-SQL automation for IP Operations that has processed close to 10,000 staffing update requests.</p>
          <span class="link-arrow">Read the case study →</span>
        </a>
        <div class="item tilt" data-tilt="3" data-reveal style="--i:1">
          <h3>Firm intranet on Infodash</h3>
          <p class="muted">Helped implement the firm's intranet on Infodash and built Power Automate flows for the Marketing team on it.</p>
          <span class="soon">Case study coming soon</span>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
<style>
  .intro { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.8fr); gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .intro .btn-row { margin-top: 1.75rem; }
  .portrait { border-radius: 32px; overflow: hidden; box-shadow: var(--shadow-lg); border: 1px solid rgba(255, 255, 255, 0.12); max-width: 340px; justify-self: end; aspect-ratio: 1; }
  .portrait img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .cols { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(1.5rem, 5vw, 4rem); align-items: start; }
  .cols h2 { margin: 0; }
  .body .lead { margin: 0 0 1.25rem; color: var(--text); }
  .body p:last-child { margin: 0; color: var(--muted); font-size: 1.08rem; }
  .work { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
  .item { display: flex; flex-direction: column; gap: 0.6rem; padding: 1.75rem; border-radius: 24px; background: var(--surface); border: 1px solid var(--border); box-shadow: var(--shadow); color: inherit; text-decoration: none; }
  a.item:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
  .item h3 { margin: 0; font-size: 1.35rem; }
  .item p { margin: 0; }
  .item .link-arrow, .soon { margin-top: auto; padding-top: 0.6rem; font-size: 0.95rem; }
  .item .link-arrow { color: var(--accent); }
  .soon { color: var(--muted); font-weight: 600; }
  @media (max-width: 760px) {
    .intro, .cols { grid-template-columns: 1fr; }
    .portrait { justify-self: start; max-width: 220px; grid-row: 1; border-radius: 26px; }
  }
</style>
