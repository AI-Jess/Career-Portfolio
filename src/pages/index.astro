---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { software } from '../data/stack';

const cases = (await getCollection('caseStudies', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order || +b.data.launched - +a.data.launched);
const featured = cases.filter((c) => c.data.featured).slice(0, 3);

// Toolkit: the first group in src/data/stack.ts becomes the four illustrated tiles, the rest become list tiles
const [platform, ...otherGroups] = software;
const art = ['flow', 'app', 'chart', 'agent'];

const steps = [
  { name: 'Requirements', text: 'Gathered with the people who do the work.' },
  { name: 'Design', text: 'The process first, the tool second.' },
  { name: 'Build', text: 'Power Automate, Power Apps, Power BI, and Copilot agents.' },
  { name: 'Test', text: 'Proven before anyone depends on it.' },
  { name: 'Support', text: 'Looked after and improved in production.' },
];
---
<Base stage>
  <!-- Hero: pinned while the 3D monogram opens up, then the page scrolls on -->
  <section class="stage stage-round hero" data-stage data-scrub data-scene="logo">
    <div class="hero-pin">
      <div class="aurora" aria-hidden="true"></div>
      <canvas class="stage-canvas" aria-hidden="true"></canvas>
      <img class="stage-fallback hero-logo" src="/brand/jv-logo.svg" alt="" width="456" height="260" />

      <div class="hero-copy hero-a">
        <p class="eyebrow">{site.role}</p>
        <h1 class="display">{site.headline[0]}<br /><span class="grad-text">{site.headline[1]}</span></h1>
        <p class="lead">{site.tagline}</p>
        <div class="btn-row">
          <a class="btn primary" href="/case-studies/">See the work <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn ghost" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>

      <div class="hero-copy hero-b">
        <p class="display second">{site.intro[0]}</p>
        <p class="lead">{site.intro[1]}</p>
      </div>

      <div class="scroll-cue" aria-hidden="true"><span></span>Scroll</div>
      <p class="drag-hint" aria-hidden="true">Drag to rotate</p>
    </div>
  </section>

  <!-- Toolkit -->
  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Toolkit</p>
        <h2>What I build with.</h2>
      </div>
      <div class="bento">
        {platform.items.map((item, i) => (
          <article class:list={['tile', 'tilt', `tile-${art[i] ?? 'plain'}`, { 'tile-wide': i === 0, 'tile-half': i >= 2 }]} data-tilt="3" data-reveal style={`--i:${i}`}>
            <div class="tile-art" aria-hidden="true">
              {art[i] === 'flow' && (
                <svg viewBox="0 0 520 200" fill="none">
                  <path class="wire" d="M70 100 H180 M250 100 H300 M300 100 C330 100 330 46 360 46 H388 M300 100 C330 100 330 154 360 154 H388" />
                  <rect class="node" x="18" y="74" width="104" height="52" rx="14" />
                  <rect class="node hot" x="180" y="70" width="70" height="60" rx="16" />
                  <rect class="node" x="388" y="22" width="112" height="48" rx="14" />
                  <rect class="node" x="388" y="130" width="112" height="48" rx="14" />
                  <path class="glyph" d="M40 94h60M40 106h38M410 46h66M410 154h66M203 100l10 10 16-20" />
                  <circle class="dot d1" r="5" /><circle class="dot d2" r="5" /><circle class="dot d3" r="5" />
                </svg>
              )}
              {art[i] === 'app' && (
                <div class="app-art"><span class="scr back"></span><span class="scr mid"></span><span class="scr front"><i></i><i></i><i></i><b></b></span></div>
              )}
              {art[i] === 'chart' && (
                <div class="chart-art"><i style="--h:38%"></i><i style="--h:62%"></i><i style="--h:48%"></i><i style="--h:84%"></i><i style="--h:70%"></i><i style="--h:100%"></i></div>
              )}
              {art[i] === 'agent' && (
                <div class="agent-art"><span class="bub q"></span><span class="bub a"><i></i><i></i><i></i></span><span class="spark">✦</span></div>
              )}
            </div>
            <h3>{item.name}</h3>
            {item.note && <p class="muted">{item.note}</p>}
          </article>
        ))}
        {otherGroups.map((g, i) => (
          <article class="tile tile-list tilt" data-tilt="3" data-reveal style={`--i:${i + 1}`}>
            <h3>{g.title}</h3>
            <ul class="chips">{g.items.map((it) => <li>{it.name}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="more-link" data-reveal><a class="link-arrow" href="/stack/">See the full stack and my desk setup →</a></p>
    </div>
  </section>

  <!-- How I work -->
  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">How I work</p>
        <h2>From process to <span class="grad-text">production.</span></h2>
        <p class="lead">{site.intro[1]}</p>
      </div>
      <ol class="steps" data-progress>
        {steps.map((s, i) => (
          <li data-reveal style={`--i:${i}`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.name}</h3>
            <p class="muted">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Featured work -->
  <section class="section">
    <div class="wrap">
      <div class="section-head split" data-reveal>
        <div>
          <p class="eyebrow">Featured work</p>
          <h2>Real problems. Measured results.</h2>
        </div>
        <a class="link-arrow" href="/case-studies/">All case studies →</a>
      </div>
      <div class="cases">{featured.map((c) => <div data-reveal><CaseCard entry={c} /></div>)}</div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  import { whenNear } from '../scripts/three/lazy';
  const hero = document.querySelector<HTMLElement>('[data-scene="logo"]');
  if (hero) {
    whenNear(hero, async () => { (await import('../scripts/three/logo')).mountLogo(hero); });
    // Once the first message has faded, stop its buttons catching clicks
    const sync = () => hero.toggleAttribute('data-phase-b', ((hero as any).__p ?? 0) > 0.3);
    window.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero-pin { position: relative; min-height: 100svh; display: flex; flex-direction: column; align-items: center; padding-top: var(--nav-h); }
  /* The flat logo holds the space the 3D logo appears in (and stands in for it without WebGL or JavaScript) */
  .hero-logo { height: 34svh; width: auto; max-width: 78vw; object-fit: contain; margin: 4svh auto 2svh; flex: none; }
  .hero :global(.stage-canvas) { height: 100svh; }
  .hero-copy { position: relative; z-index: 2; width: 100%; max-width: 62rem; margin-top: auto; padding: 0 20px clamp(4.5rem, 11vh, 7rem); text-align: center; display: grid; justify-items: center; gap: 1.1rem; pointer-events: none; }
  .hero-copy :global(a) { pointer-events: auto; }
  .hero-copy .eyebrow { margin: 0; }
  .hero-copy .lead { margin: 0; max-width: 40rem; }
  .hero-copy .btn-row { justify-content: center; margin-top: 0.5rem; }
  .display.second { font-size: clamp(2.3rem, 6.4vw, 4.75rem); }
  .hero-b { margin-top: 0; }
  .scroll-cue, .drag-hint { display: none; }

  /* With JavaScript and motion allowed: pin the hero and cross-fade the two messages as you scroll */
  :global(html.js.motion) .hero { height: 210svh; }
  :global(html.js.motion) .hero-pin { position: sticky; top: 0; height: 100svh; min-height: 0; overflow: hidden; }
  :global(html.js.motion) .hero-copy { position: absolute; inset: auto 0 0 0; margin: 0 auto; }
  :global(html.js.motion) .hero-a { opacity: calc(1 - var(--p, 0) * 3.4); transform: translate3d(0, calc(var(--p, 0) * -70px), 0); }
  :global(html.js.motion) .hero-b { opacity: clamp(0, calc((var(--p, 0) - 0.42) * 4.5), 1); transform: translate3d(0, calc((1 - min(1, var(--p, 0) * 1.5)) * 50px), 0); }
  :global(html.js.motion) .hero[data-phase-b] .hero-a :global(a) { pointer-events: none; }
  :global(html.js.motion) .scroll-cue { display: flex; position: absolute; z-index: 2; left: 50%; bottom: 1.4rem; transform: translateX(-50%); flex-direction: column; align-items: center; gap: 0.5rem; font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); opacity: calc(1 - var(--p, 0) * 6); }
  .scroll-cue span { width: 1px; height: 30px; background: linear-gradient(var(--brand-blue), transparent); animation: cue 2.2s var(--ease) infinite; transform-origin: top; }
  @keyframes cue { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
  :global(html.js.motion) .is-live .drag-hint, :global(html.js.motion) .is-live.hero .drag-hint { display: block; position: absolute; z-index: 2; right: 24px; top: calc(var(--nav-h) + 18px); margin: 0; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); opacity: calc(0.8 - var(--p, 0) * 4); }
  @media (max-width: 720px) { .drag-hint { display: none !important; } }
  @media (max-height: 620px) { .hero-copy .lead { display: none; } }

  /* ---------- Toolkit bento ---------- */
  .bento { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; }
  .tile { grid-column: span 2; display: flex; flex-direction: column; padding: 1.5rem; border-radius: 24px; background: var(--surface); border: 1px solid var(--border); box-shadow: var(--shadow); overflow: hidden; }
  .tile:hover { border-color: color-mix(in srgb, var(--accent) 40%, var(--border)); }
  .tile-wide { grid-column: span 4; }
  .tile-half { grid-column: span 3; }
  .tile-list { grid-column: span 2; justify-content: space-between; gap: 1.5rem; }
  .tile h3 { margin: 0 0 0.3rem; font-size: 1.35rem; }
  .tile p { margin: 0; font-size: 0.96rem; }
  .tile-art { height: 190px; margin: -0.25rem -0.25rem 1.25rem; border-radius: 16px; display: grid; place-items: center; overflow: hidden;
    background: radial-gradient(120% 120% at 20% 0%, color-mix(in srgb, var(--brand-blue) 30%, transparent), transparent 60%), radial-gradient(120% 120% at 90% 100%, color-mix(in srgb, var(--brand-green) 34%, transparent), transparent 60%), var(--surface-2); }
  @media (max-width: 900px) { .tile, .tile-half, .tile-list { grid-column: span 3; } .tile-wide { grid-column: span 6; } .tile-list:last-child:nth-child(odd) { grid-column: span 6; } }
  @media (max-width: 600px) { .tile, .tile-wide, .tile-half, .tile-list { grid-column: span 6; } }
  .more-link { margin: 2rem 0 0; }

  /* Tile art: a flow with requests moving through it */
  .tile-art svg { width: min(92%, 520px); height: auto; }
  .wire { stroke: color-mix(in srgb, var(--accent) 55%, transparent); stroke-width: 2; stroke-dasharray: 3 7; stroke-linecap: round; }
  .node { fill: var(--surface); stroke: color-mix(in srgb, var(--accent) 45%, var(--border)); stroke-width: 1.5; }
  .node.hot { fill: var(--accent); stroke: var(--accent); }
  .glyph { stroke: color-mix(in srgb, var(--text) 40%, transparent); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .node.hot ~ .glyph { }
  .dot { fill: var(--accent); offset-rotate: 0deg; animation: travel 3.6s linear infinite; }
  .d1 { offset-path: path('M70 100 H300 C330 100 330 46 360 46 H440'); }
  .d2 { offset-path: path('M70 100 H300 C330 100 330 154 360 154 H440'); animation-delay: -1.2s; }
  .d3 { offset-path: path('M70 100 H300 C330 100 330 46 360 46 H440'); animation-delay: -2.4s; }
  @keyframes travel { 0% { offset-distance: 0%; opacity: 0; } 8% { opacity: 1; } 92% { opacity: 1; } 100% { offset-distance: 100%; opacity: 0; } }

  /* Tile art: layered app screens */
  .app-art { position: relative; width: 150px; height: 130px; transform: perspective(700px) rotateX(18deg) rotateZ(-8deg); transform-style: preserve-3d; }
  .scr { position: absolute; inset: 0; border-radius: 14px; background: var(--surface); border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border)); box-shadow: 0 14px 24px -14px rgba(16, 22, 27, 0.5); transition: transform 0.6s var(--ease); }
  .scr.back { transform: translate3d(26px, -20px, -40px); opacity: 0.5; }
  .scr.mid { transform: translate3d(13px, -10px, -20px); opacity: 0.8; }
  .tile:hover .scr.back { transform: translate3d(44px, -34px, -40px); }
  .tile:hover .scr.mid { transform: translate3d(22px, -17px, -20px); }
  .scr.front { display: grid; gap: 9px; padding: 16px; align-content: start; }
  .scr.front i { height: 12px; border-radius: 6px; background: var(--surface-2); border: 1px solid var(--border); }
  .scr.front i:nth-child(2) { width: 70%; }
  .scr.front b { height: 22px; width: 58%; border-radius: 999px; background: var(--accent); margin-top: 4px; }

  /* Tile art: bars that grow when the tile appears */
  .chart-art { display: flex; align-items: flex-end; gap: 10px; height: 120px; }
  .chart-art i { width: 18px; height: var(--h); border-radius: 6px 6px 2px 2px; background: linear-gradient(var(--brand-green), var(--accent)); transform-origin: bottom; }
  :global(html.js.motion) .tile .chart-art i { transform: scaleY(0.08); transition: transform 1.1s var(--ease); }
  :global(html.js.motion) .tile.is-in .chart-art i { transform: none; }
  .chart-art i:nth-child(2) { transition-delay: 0.08s; } .chart-art i:nth-child(3) { transition-delay: 0.16s; }
  .chart-art i:nth-child(4) { transition-delay: 0.24s; } .chart-art i:nth-child(5) { transition-delay: 0.32s; } .chart-art i:nth-child(6) { transition-delay: 0.4s; }

  /* Tile art: a question and an answer */
  .agent-art { position: relative; width: 190px; height: 120px; }
  .bub { position: absolute; border-radius: 16px; }
  .bub.q { left: 0; top: 6px; width: 110px; height: 34px; background: var(--surface); border: 1px solid var(--border); border-bottom-left-radius: 4px; }
  .bub.a { right: 0; bottom: 6px; width: 132px; height: 52px; background: var(--accent); border-bottom-right-radius: 4px; display: flex; align-items: center; justify-content: center; gap: 7px; }
  .bub.a i { width: 8px; height: 8px; border-radius: 50%; background: var(--accent-ink); animation: typing 1.3s ease-in-out infinite; }
  .bub.a i:nth-child(2) { animation-delay: 0.15s; } .bub.a i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes typing { 0%, 60%, 100% { transform: translateY(0); opacity: 0.5; } 30% { transform: translateY(-5px); opacity: 1; } }
  .spark { position: absolute; right: 8px; top: 0; font-size: 1.5rem; color: var(--accent); animation: twinkle 2.6s ease-in-out infinite; }
  @keyframes twinkle { 0%, 100% { transform: scale(0.8) rotate(0deg); opacity: 0.5; } 50% { transform: scale(1.15) rotate(20deg); opacity: 1; } }

  /* ---------- Steps ---------- */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.5rem; position: relative; }
  .steps::before, .steps::after { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 2px; border-radius: 2px; }
  .steps::before { background: var(--border); }
  .steps::after { background: var(--grad); transform-origin: left; transform: scaleX(var(--p, 1)); }
  .steps li { padding-top: 1.5rem; }
  .num { font-size: 0.85rem; font-weight: 650; letter-spacing: 0.08em; color: var(--accent); font-variant-numeric: tabular-nums; }
  .steps h3 { margin: 0.4rem 0 0.35rem; font-size: 1.3rem; }
  .steps p { margin: 0; font-size: 0.95rem; }
  @media (max-width: 860px) {
    .steps { grid-template-columns: 1fr; gap: 0; padding-left: 1.5rem; }
    .steps::before, .steps::after { left: 0; right: auto; top: 0; bottom: 0; width: 2px; height: auto; }
    .steps::after { transform-origin: top; transform: scaleY(var(--p, 1)); }
    .steps li { padding: 0 0 1.75rem; }
  }

  /* ---------- Featured work ---------- */
  .section-head.split { max-width: none; display: flex; justify-content: space-between; align-items: end; gap: 1rem 2rem; flex-wrap: wrap; }
  .cases { display: grid; gap: 1.5rem; }

  @media (prefers-reduced-motion: reduce) {
    .dot, .bub.a i, .spark, .scroll-cue span { animation: none; }
    .dot { offset-distance: 60%; }
  }
</style>
