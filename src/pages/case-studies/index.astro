---
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';

const cases = (await getCollection('caseStudies', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order || +b.data.launched - +a.data.launched);
---
<Base title="Case studies" description="Power Platform and AI automation case studies for legal operations." stage>
  <section class="stage stage-round page-stage" data-stage>
    <div class="aurora" aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow">Case studies</p>
      <h1>Real problems. <span class="grad-text">Measured results.</span></h1>
      <p class="lead">Each one follows the same shape: the problem, what I built, how it works, and what changed.</p>
    </div>
  </section>
  <section class="wrap list">
    {cases.map((c) => <div data-reveal><CaseCard entry={c} /></div>)}
  </section>
  <CtaBand />
</Base>
<style>
  .list { display: grid; gap: 1.5rem; padding-top: clamp(2.5rem, 6vw, 4.5rem); }
</style>
