{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "launched": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "value",
          "label"
        ]
      }
    },
    "order": {
      "default": 100,
      "type": "number"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "summary",
    "org",
    "role",
    "launched",
    "tools"
  ]
}