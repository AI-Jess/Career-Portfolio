---
import Base from '../../layouts/Base.astro';
import Mermaid from '../../components/Mermaid.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const cases = await getCollection('caseStudies', ({ data }) => !data.draft);
  return cases.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const fmt = (dt: Date, day = false) => dt.toLocaleDateString('en-US', { month: 'long', ...(day ? { day: 'numeric' } : {}), year: 'numeric', timeZone: 'UTC' });
const launched = fmt(d.launched);
const published = d.published ? fmt(d.published, true) : null;
const asOf = d.metricsAsOf ? fmt(d.metricsAsOf, true) : null;
const pipe = d.pipeline;
const ownerText = (o?: string) => (o ? (o.toLowerCase() === 'me' ? 'Built by me' : `Built by ${o}`) : null);
---
<Base title={d.title} description={d.summary} stage>
  <!-- Dark stage: title, the system as an interactive 3D scene, and the headline numbers -->
  <section class="stage stage-round case-stage" data-stage>
    <div class="aurora" aria-hidden="true"></div>
    <div class="wrap head">
      <a class="back" href="/case-studies/">← Case studies</a>
      <p class="eyebrow">{d.org}</p>
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
    </div>

    {pipe.length > 0 && (
      <div class="wrap">
        <div class="pipe" data-scene="pipeline" data-steps={JSON.stringify(pipe)}>
          <div class="pipe-view"><canvas class="stage-canvas" aria-hidden="true"></canvas></div>
          <ol class="pipe-steps">
            {pipe.map((s, i) => (
              <li class:list={{ mine: s.mine }} tabindex="0">
                <span class="n">{i + 1}</span>
                <span class="t">
                  <strong>{s.label}</strong>
                  {ownerText(s.owner) && <em>{ownerText(s.owner)}</em>}
                  <span class="detail">{s.detail}{s.failure && ` ${s.failure}`}</span>
                </span>
              </li>
            ))}
          </ol>
          {pipe.some((s) => s.failure) && <span class="pipe-fail" aria-hidden="true">Failure notice</span>}
          <p class="pipe-caption" aria-live="polite"></p>
          <p class="pipe-hint" aria-hidden="true">Hover or tap a step</p>
        </div>
      </div>
    )}

    {d.metrics.length > 0 && (
      <div class="wrap">
        <ul class="metrics" aria-label="Results">
          {d.metrics.map((m, i) => (
            <li data-reveal style={`--i:${i}`}>
              <strong class="grad-text" data-count>{m.value}</strong>
              <span>{m.label}</span>
              {m.note && <small>{m.note}</small>}
            </li>
          ))}
        </ul>
        {asOf && <p class="asof">Figures as of <time datetime={d.metricsAsOf!.toISOString().slice(0, 10)}>{asOf}</time>.</p>}
      </div>
    )}
  </section>

  <article class="wrap page">
    <div class="prose"><Content /></div>

    <aside class="rail">
      <dl class="meta card">
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        <div><dt>Launched</dt><dd>{launched}</dd></div>
        {d.status && <div><dt>Status</dt><dd><span class="live-dot" aria-hidden="true"></span>{d.status}</dd></div>}
        {published && <div><dt>Case study published</dt><dd><time datetime={d.published!.toISOString().slice(0, 10)}>{published}</time></dd></div>}
        <div><dt>Tools</dt><dd><ul class="chips">{d.tools.map((t) => <li>{t}</li>)}</ul></dd></div>
      </dl>
    </aside>
  </article>

  <CtaBand />
  <Mermaid />
</Base>

<script>
  import { whenNear } from '../../scripts/three/lazy';
  const el = document.querySelector<HTMLElement>('[data-scene="pipeline"]');
  if (el) {
    const steps = JSON.parse(el.dataset.steps || '[]');
    whenNear(el, async () => { await (await import('../../scripts/three/pipeline')).mountPipeline(el, steps); });
  }
</script>

<style>
  /* ---------- Stage ---------- */
  .case-stage { padding: calc(var(--nav-h) + clamp(2rem, 5vw, 3.5rem)) 0 clamp(2.5rem, 6vw, 4.5rem); }
  .back { display: inline-block; margin-bottom: 2rem; font-size: 0.9rem; text-decoration: none; color: var(--muted); }
  .back:hover { color: var(--text); }
  .head h1 { max-width: 18ch; }
  .head .lead { max-width: 46rem; margin: 0; }

  /* ---------- 3D pipeline ---------- */
  .pipe { position: relative; margin-top: clamp(1.5rem, 4vw, 3rem); --pipe-h: clamp(360px, 50vh, 520px); }
  .pipe-view { display: none; position: relative; height: var(--pipe-h); }
  .pipe.is-live .pipe-view { display: block; }
  /* Fade the scene out at its edges so glows never end in a hard line */
  .pipe-view :global(canvas) { -webkit-mask-image: linear-gradient(#0000, #000 12%, #000 90%, #0000), linear-gradient(90deg, #0000, #000 5%, #000 95%, #0000); -webkit-mask-composite: source-in; mask-image: linear-gradient(#0000, #000 12%, #000 90%, #0000), linear-gradient(90deg, #0000, #000 5%, #000 95%, #0000); mask-composite: intersect; }
  .pipe-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  .pipe-steps li { display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.9rem 1rem; border-radius: 14px; border: 1px solid var(--border); background: color-mix(in srgb, var(--surface) 70%, transparent); cursor: default; }
  .pipe-steps .n { flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--brand-blue); color: var(--ink); font-size: 0.78rem; font-weight: 700; display: grid; place-items: center; margin-top: 1px; }
  .pipe-steps li.mine .n { background: var(--brand-green); }
  .pipe-steps .t { display: grid; gap: 0.15rem; }
  .pipe-steps strong { font-size: 0.98rem; line-height: 1.25; }
  .pipe-steps em { font-style: normal; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .pipe-steps li.mine em { color: var(--brand-green); }
  .pipe-steps .detail { font-size: 0.88rem; line-height: 1.45; color: var(--muted); margin-top: 0.2rem; }
  .pipe-fail, .pipe-caption, .pipe-hint { display: none; }

  /* Live on wide screens: labels float under their panels, the caption explains the focused step */
  .pipe.is-live:not(.is-portrait) .pipe-steps { position: absolute; z-index: 3; inset: 0 0 auto 0; height: var(--pipe-h); display: block; pointer-events: none; }
  .pipe.is-live:not(.is-portrait) .pipe-steps li { position: absolute; left: 0; top: 0; width: 210px; justify-content: center; text-align: center; padding: 0.35rem 0.5rem; border: 0; background: none; pointer-events: auto; cursor: pointer; opacity: 0.62; transition: opacity 0.3s; will-change: transform; }
  .pipe.is-live:not(.is-portrait) .pipe-steps li.is-active { opacity: 1; }
  .pipe.is-live:not(.is-portrait) .pipe-steps .n, .pipe.is-live:not(.is-portrait) .pipe-steps .detail { display: none; }
  .pipe.is-live:not(.is-portrait) .pipe-steps .t { justify-items: center; }
  .pipe.is-live .pipe-fail { display: block; position: absolute; z-index: 3; left: 0; top: 0; pointer-events: none; white-space: nowrap; font-size: 0.72rem; font-weight: 650; letter-spacing: 0.05em; text-transform: uppercase; color: var(--warn); will-change: transform; }
  .pipe.is-live:not(.is-portrait) .pipe-caption { display: block; margin: 0.5rem auto 0; max-width: 44rem; min-height: 3.2em; text-align: center; font-size: 1.02rem; line-height: 1.5; color: var(--muted); }
  .pipe-caption :global(strong) { color: var(--text); }
  .pipe.is-live:not(.is-portrait) .pipe-hint { display: block; position: absolute; right: 0; top: 0; margin: 0; font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); opacity: 0.8; }

  /* Live on tall screens: the scene on top, steps as a tappable list beneath it */
  .pipe.is-live.is-portrait { --pipe-h: min(118vw, 540px); }
  .pipe.is-live.is-portrait .pipe-steps { margin-top: 1rem; grid-template-columns: 1fr; gap: 0.5rem; }
  .pipe.is-live.is-portrait .pipe-steps li { cursor: pointer; transition: border-color 0.3s, background 0.3s; }
  .pipe.is-live.is-portrait .pipe-steps li.is-active { border-color: var(--brand-blue); background: color-mix(in srgb, var(--brand-blue) 10%, var(--surface)); }
  .pipe.is-live.is-portrait .pipe-fail { font-size: 0.56rem; }

  /* ---------- Headline numbers ---------- */
  .metrics { list-style: none; padding: 0; margin: clamp(2rem, 5vw, 3.5rem) 0 0; display: grid; gap: 2rem 1.5rem; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--border); padding-top: clamp(1.75rem, 4vw, 2.75rem); }
  .metrics li { display: flex; flex-direction: column; gap: 0.35rem; }
  .metrics strong { font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 700; letter-spacing: -0.045em; line-height: 1; white-space: nowrap; width: fit-content; }
  .metrics span { font-size: 0.98rem; line-height: 1.35; }
  .metrics small { font-size: 0.78rem; line-height: 1.45; color: var(--muted); }
  .asof { font-size: 0.8rem; color: var(--muted); margin: 1.5rem 0 0; }
  @media (max-width: 860px) { .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 420px) { .metrics strong { font-size: 1.9rem; } }

  /* ---------- Article + details rail ---------- */
  .page { display: grid; grid-template-columns: minmax(0, 760px) minmax(220px, 1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; padding-top: clamp(3rem, 7vw, 5rem); }
  .page :global(.prose) { max-width: none; min-width: 0; }
  .rail { position: sticky; top: calc(var(--nav-h) + 24px); }
  .meta { display: grid; gap: 1.1rem; padding: 1.4rem; margin: 0; border-radius: 20px; box-shadow: var(--shadow); }
  .meta dt { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 600; }
  .meta dd { margin: 0.25rem 0 0; font-size: 0.93rem; line-height: 1.45; }
  .meta .chips { margin-top: 0.35rem; }
  .live-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #2fb37a; margin-right: 0.45rem; box-shadow: 0 0 0 0 rgba(47, 179, 122, 0.6); animation: pulse 2.4s ease-out infinite; }
  @keyframes pulse { to { box-shadow: 0 0 0 9px rgba(47, 179, 122, 0); } }
  @media (max-width: 980px) {
    .page { grid-template-columns: minmax(0, 1fr); }
    .rail { position: static; grid-row: 1; }
    .meta { grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }
    .meta div:last-child { grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: reduce) { .live-dot { animation: none; } }
</style>
